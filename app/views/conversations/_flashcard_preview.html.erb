<%# The cards to review before saving. Rendered whole when generation is not
    streamed, and as an empty shell when it is: flashcard_stream_controller then
    appends each card into [data-flashcard-list] as it is written, and enables
    Save once the list is complete -- saving half a list would lose the rest. %>
<div class="my-5 response" data-controller="scroll">
  <div class="d-flex align-items-center gap-2 mb-3">
    <i class="fa-solid fa-wand-magic-sparkles fs-4 wand-icon pera-green me-2"></i>
    <h3 class="mb-0 pera-green"><%= t("conversations.generate_flashcards.title") %></h3>
  </div>
  <%= simple_form_for conversation, url: conversation_flashcards_path(conversation), method: :post do |f| %>
    <div class="row g-3" data-flashcard-list>
      <% flashcards.each_with_index do |flashcard, index| %>
        <%= render "conversations/flashcard_preview_card", flashcard: flashcard, index: index %>
      <% end %>
    </div>
    <% if streaming %>
      <p class="mt-4 mb-0 pera-green" data-flashcard-status>
        <i class="fa-solid fa-pen-nib" aria-hidden="true"></i> <%= t("conversations.generate_flashcards.writing") %>
      </p>
    <% end %>
    <div class="d-flex justify-content-end">
      <%= f.button :submit, t("conversations.generate_flashcards.save"), class: "btn pera-btn-outline my-5",
                   disabled: streaming, data: { flashcard_save: true } %>
    </div>
  <% end %>
</div>
