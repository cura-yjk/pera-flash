<%# One card in the preview. index names its fields, so the cards save in the
    order they were written. %>
<div class="col-md-4">
  <div class="flashcard-preview-card shadow-sm rounded-5 overflow-hidden h-100">
    <div class="d-flex align-items-center justify-content-between px-3 py-2 flashcard-header">
      <span class="badge rounded-pill fw-semibold pera-green fs-6">#<%= index + 1 %></span>
      <i class="fa-solid fa-layer-group opacity-75 stack-icon"></i>
    </div>
    <div class="p-3">
      <%# Left out on save unless the front is edited into something new --
          the save checks again rather than trusting this mark. %>
      <% if (known = flashcard.duplicate_of) %>
        <p class="small text-warning-emphasis mb-3" data-duplicate>
          <i class="fa-solid fa-clone me-1" aria-hidden="true"></i>
          <% if known.persisted? %>
            <%= t("conversations.generate_flashcards.duplicate") %>
            <span class="d-block text-body-secondary mt-1"><%= with_furigana(known.question) %> — <%= with_furigana(known.answer) %></span>
          <% else %>
            <%= t("conversations.generate_flashcards.duplicate_in_batch") %>
          <% end %>
        </p>
      <% end %>
      <label class="text-uppercase small fw-semibold mb-3 d-block pera-green"><%= t("conversations.generate_flashcards.question") %></label>
      <%= text_area_tag "conversation[flashcards][#{index}][question]", flashcard.question,
            class: "form-control border-0 px-0 flashcard-textarea mb-4 rounded-4 px-3 js-dash-card", rows: 2 %>
      <hr class="my-3 opacity-25">
      <label class="text-uppercase small fw-semibold mb-3 d-block pera-green"><%= t("conversations.generate_flashcards.answer") %></label>
      <%= text_area_tag "conversation[flashcards][#{index}][answer]", flashcard.answer,
            class: "form-control border-0 px-0 flashcard-textarea mt-3 rounded-4 px-3 js-dash-card", rows: 2 %>
    </div>
  </div>
</div>
