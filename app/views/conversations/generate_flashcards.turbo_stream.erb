<%= turbo_stream.append "messages" do %>
  <div id="flashcard-preview" class="mt-4">
    <div class="d-flex align-items-center gap-2 mb-3">
      <i class="fa-solid fa-wand-magic-sparkles text-primary fs-4"></i>
      <h5 class="mb-0">Review your flashcards</h5>
    </div>
    <%= simple_form_for @conversation, url: conversation_flashcards_path(@conversation), method: :post do |f| %>
      <div class="row g-3">
        <% @flashcards.each_with_index do |flashcard, i| %>
          <div class="col-md-4">
            <div class="flashcard-preview-card shadow-sm rounded-4 overflow-hidden h-100">
              <div class="d-flex align-items-center justify-content-between px-3 py-2 flashcard-header">
                <span class="badge rounded-pill bg-white text-primary fw-semibold">#<%= i + 1 %></span>
                <i class="fa-solid fa-layer-group text-white opacity-75"></i>
              </div>
              <div class="p-3 bg-white">
                <label class="text-uppercase text-primary small fw-semibold mb-1 d-block">Question</label>
                <%= text_area_tag "conversation[flashcards][#{i}][question]", flashcard.question,
                      class: "form-control border-0 px-0 flashcard-textarea mb-3", rows: 2 %>
                <hr class="my-2 opacity-25">
                <label class="text-uppercase text-secondary small fw-semibold mb-1 d-block">Answer</label>
                <%= text_area_tag "conversation[flashcards][#{i}][answer]", flashcard.answer,
                      class: "form-control border-0 px-0 flashcard-textarea", rows: 2 %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
      <div class="d-flex justify-content-end">
        <%= f.button :submit, "Save to Flashcards", class: "btn btn-primary mt-4" %>
      </div>
    <% end %>
  </div>
<% end %>
