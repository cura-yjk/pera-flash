<%= turbo_stream.append "messages" do %>
  <div id="flashcard-preview" class="mt-4">
    <div class="d-flex align-items-center gap-2 mb-3">
      <i class="fa-solid fa-wand-magic-sparkles fs-4 wand-icon pera-green me-2"></i>
      <h3 class="mb-0 pera-green">Review your flashcards</h3>
    </div>
    <%= simple_form_for @conversation, url: conversation_flashcards_path(@conversation), method: :post do |f| %>
      <div class="row g-3">
        <% @flashcards.each_with_index do |flashcard, i| %>
          <div class="col-md-4">

            <div class="flashcard-preview-card shadow-sm rounded-5 overflow-hidden h-100">
              <div class="d-flex align-items-center justify-content-between px-3 py-2 flashcard-header">
                <span class="badge rounded-pill fw-semibold pera-green fs-6">#<%= i + 1 %></span>
                <i class="fa-solid fa-layer-group opacity-75 stack-icon"></i>
              </div>

              <div class="p-3">
                <label class="text-uppercase small fw-semibold mb-3 d-block pera-green">Question</label>
                <%= text_area_tag "conversation[flashcards][#{i}][question]", flashcard.question,
                      class: "form-control border-0 px-0 flashcard-textarea mb-4 rounded-4 px-3 js-dash-card", rows: 2 %>
                <hr class="my-3 opacity-25">
                <label class="text-uppercase small fw-semibold mb-3 d-block pera-green">Answer</label>
                <%= text_area_tag "conversation[flashcards][#{i}][answer]", flashcard.answer,
                      class: "form-control border-0 px-0 flashcard-textarea mt-3 rounded-4 px-3 js-dash-card", rows: 2 %>
              </div>
            </div>

          </div>
        <% end %>
      </div>
      <div class="d-flex justify-content-end">
        <%= f.button :submit, "Save to Flashcards", class: "btn gen-flash-btn rounded-4 mt-4" %>
      </div>
    <% end %>
  </div>
<% end %>
