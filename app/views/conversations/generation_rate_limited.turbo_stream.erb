<%# Shown when the account is generating cards faster than the limit allows.
    Nothing was sent to the model, and the conversation is untouched. %>
<%= turbo_stream.update "flashcard-preview" do %>
  <div class="my-5 response">
    <div class="d-flex align-items-center gap-2 mb-3">
      <i class="fa-solid fa-hourglass-half fs-4 text-warning me-2"></i>
      <h3 class="mb-0"><%= t(".title") %></h3>
    </div>
    <p class="mb-0"><%= notice %></p>
  </div>
<% end %>
