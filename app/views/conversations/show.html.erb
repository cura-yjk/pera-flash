<div class="container my-5">
  <div class="d-flex justify-content-between align-items-center">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="chat-title" class="breadcrumb-item active text-secondary" aria-current="page"><%= @conversation.title %></li>
      </ol>
    </nav>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item">
          <%= button_to "Generate Flashcards",
                generate_flashcards_conversation_path(@conversation),
                method: :post,
                class: "btn btn-sm btn-outline-secondary" %>
        </li>
        <li class="breadcrumb-item"><%= link_to 'New Chat', conversations_path(@conversation), data: { turbo_method: :post }, class: "text-secondary" %></li>
      </ol>
    </nav>
  </div>

  <div id="messages">
    <%= render @messages %>
  </div>
  <div id="new_message" class="fixed-bottom mb-5">
    <%= render "messages/form", conversation: @conversation, message: @message %>
  </div>
</div>

