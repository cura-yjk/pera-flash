<div class="container my-5">
  <div class="d-flex justify-content-between align-items-center">
    <nav aria-label="breadcrumb">
      <div id="conversation_title">
        <%= render "conversations/title", conversation: @conversation %>
      </div>
    </nav>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><%= link_to 'New Chat', conversations_path(@conversation), data: { turbo_method: :post }, class: "text-secondary" %></li>
      </ol>
    </nav>
  </div>
  <div id="messages">
    <%= render @messages %>
    <div class="d-flex justify-content-end my-3">
      <%= button_to generate_flashcards_conversation_path(@conversation),
          method: :post,
          class: "btn gen-flash-btn d-flex align-items-center gap-2 rounded-4" do %>
        <i class="fa-solid fa-layer-group"></i> Generate Flashcards
      <% end %>
    </div>
  </div>
  <div id="new_message" class="fixed-bottom mb-5">
    <%= render "messages/form", conversation: @conversation, message: @message %>
  </div>
</div>
