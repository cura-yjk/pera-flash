<div class="container my-5 chat-page">
  <%= render "shared/back_link", path: conversations_path, label: t("conversations.index.title") %>

  <%# Both of these used to sit in <nav aria-label="breadcrumb"><ol class="breadcrumb">.
      Neither was a breadcrumb: one wrapped the conversation's title, the other
      a button that starts a new conversation. A screen reader announced a
      trail of ancestors and found a heading and an action. The way back is the
      link above, which is the thing a breadcrumb would have been for. %>
  <div class="d-flex justify-content-between align-items-center mt-2">
    <div id="conversation_title">
      <%= render "conversations/title", conversation: @conversation %>
    </div>

    <%= link_to t("conversations.new_chat"), conversations_path(@conversation),
          data: { turbo_method: :post }, class: "text-secondary text-decoration-none" %>
  </div>
  <div id="messages">
    <%= render "messages/empty", conversation: @conversation if @messages.empty? %>
    <%= render @messages %>
  </div>
  <div class="d-flex justify-content-end my-3" id="flashcard-btn">
    <%= render "flashcards/btn", conversation: @conversation, messages: @conversation.messages %>
  </div>
  <div id="flashcard-preview"></div>
  <div id="new_message" class="fixed-bottom chat-dock">
    <%= render "messages/form", conversation: @conversation, message: @message %>
  </div>
</div>

