<%# Page container for the decks index view %>
<div class="container mt-4">

  <%# Page header %>
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Your Decks</h1>
  </div>

  <%# Inline form to create a new deck; posts to DecksController#create.
      Falls back to a blank Deck if @deck wasn't set (e.g. on a successful create/index load) %>
  <%= form_with model: @deck || Deck.new, url: decks_path do |f| %>
    <div class="input-group mb-3">
      <%= f.text_field :name, class: "form-control", placeholder: "New deck name" %>
      <%= f.submit "Create", class: "btn pera-btn" %>
    </div>

    <%# Show validation errors if deck creation failed (e.g. blank name) %>
    <% if @deck&.errors&.any? %>
      <div class="text-danger small"><%= @deck.errors.full_messages.to_sentence %></div>
    <% end %>
  <% end %>

  <%# List existing decks as clickable cards, or show an empty state %>
  <% if @decks.any? %>
    <div class="row">
      <% @decks.each do |deck| %>
        <div class="col-md-4 mb-3">
          <%# Whole card links to the deck's show page %>
          <%= link_to deck_path(deck), class: "text-decoration-none text-dark" do %>
            <div class="card p-3 d-flex flex-row justify-content-between align-items-center">
              <span><%= deck.name %></span>
              <%# flashcards_count comes from the COUNT(...) aliased column in the controller's query, not a real DB column %>
              <span class="badge rounded-pill pera-btn"><%= deck.flashcards_count %></span>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-muted">No decks yet.</p>
  <% end %>
</div>
