<div class="container mt-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-2"><%= t(".title") %></h1>
  </div>
  <%= form_with model: @deck || Deck.new, url: decks_path do |f| %>
    <div class="input-group mb-5">
      <%= f.text_field :name, class: "form-control", placeholder: t(".name_placeholder") %>
      <%= f.submit t(".create"), class: "btn pera-btn" %>
    </div>
    <% if @deck&.errors&.any? %>
      <div class="text-danger small"><%= @deck.errors.full_messages.to_sentence %></div>
    <% end %>
  <% end %>
  <% if @decks.any? %>
    <div class="row">
      <% @decks.each do |deck| %>
        <div class="col-md-4 mb-3">
          <div class="position-relative">
            <%= button_to deck_path(deck),
                  method: :delete,
                  class: "btn icon-btn border-0 position-absolute top-0 end-0",
                  style: "z-index: 1;",
                  title: t(".delete"),
                  aria: { label: t(".delete") },
                  form: { data: { turbo_confirm: t(".confirm_delete") } } do %>
              <i class="fa-solid fa-trash pera-green" aria-hidden="true"></i>
            <% end %>
            <%= link_to deck_path(deck), class: "text-decoration-none text-dark" do %>
              <div class="card deck-card p-3 dash-card js-dash-card rounded-5">
                <span><%= deck.name %></span>
                <span class="badge deck-count"><%= deck.flashcards_count %></span>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-muted"><%= t("decks.none") %></p>
  <% end %>
</div>
