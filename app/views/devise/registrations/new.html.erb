
<div class="form-container">

  <h2 class="text-center mb-5">Sign up</h2>

  <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
    <%= f.error_notification %>

    <div class="form-inputs">
      <%= f.input :name,
                  required: true,
                  autofocus: true,
                  input_html: { class: "rounded-3" } %>
      <%= f.input :email,
                  required: true,
                  autofocus: true,
                  input_html: { autocomplete: "email", class: "form-input rounded-3" }%>
      <%= f.input :password,
                  required: true,
                  hint: ("#{@minimum_password_length} characters minimum" if @minimum_password_length),
                  input_html: { autocomplete: "new-password", class: "form-input roudned-3" } %>
      <%= f.input :password_confirmation,
                  required: true,
                  input_html: { autocomplete: "new-password", class: "form-input rounded-3" } %>
    </div>

    <div class="form-actions">
      <%= f.button :submit, "Sign up", class: "pera-btn rounded-3" %>
    </div>
    <%= render "devise/shared/links" %>
  <% end %>
</div>
