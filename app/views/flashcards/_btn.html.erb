<%# messages is what there is to card: Conversation#messages_for_flashcards, so
    the button goes once a batch is saved and comes back with the next message.
    It showed whenever the chat had any messages, and straight after a save it
    offered to card what had just been carded. The Try again in a failed
    generation passes all of them -- the material is still there. %>
<% if messages.any? %>
  <%# flashcard_stream_controller sends this itself so the cards can stream in.
      Without JavaScript it is an ordinary Turbo form and they arrive together.
      Also the Try again button in a failure notice, with its own label. %>
  <%= button_to generate_flashcards_conversation_path(conversation),
          method: :post,
          form: { data: { controller: "flashcard-stream", action: "submit->flashcard-stream#generate",
                          flashcard_stream_failed_value: render("conversations/generation_failed") } },
          class: "btn pera-btn-outline d-flex align-items-center justify-content-center gap-2 " \
                 "#{local_assigns.fetch(:button_class, 'mb-5')}" do %>
    <i class="fa-solid fa-layer-group"></i> <%= local_assigns[:label] || t("flashcards.generate") %>
  <% end %>
<% end %>
