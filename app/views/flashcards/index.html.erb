<div class="container mt-5">
  <div class="d-flex justify-content-between align-items-center my-5">
    <h1 class="mb-0">All Flashcards</h1>
    <%= form_with url: flashcards_path, method: :get, class: "d-flex" do |f| %>
      <%= f.text_field :query, value: params[:query], placeholder: t(".search_placeholder"),
      class: "form-control me-2 rounded-4 user-details-input" %>
      <%= f.submit t("search.submit"), class: "btn pera-btn rounded-4" %>
    <% end %>
  </div>
  <% if @flashcards.any? %>
    <div class="row mb-5">
      <% @flashcards.each do |flashcard| %>
        <div class="col-md-4 mb-3">
          <div class="position-relative">
            <%= button_to flashcard_path(flashcard),
                  method: :delete,
                  class: "btn btn-sm border-0 position-absolute top-0 end-0 m-2",
                  style: "z-index: 1;",
                  form: { data: { turbo_confirm: t("flashcards.confirm_delete") } } do %>
              <i class="fa-solid fa-trash pera-green"></i>
            <% end %>
            <%= link_to edit_flashcard_path(flashcard), data: { turbo_frame: "modal-#{flashcard.id}" },
            class: "text-decoration-none text-dark rounded-5 " do %>
              <div class="card p-3 flashcard-preview-card dash-card js-dash-card rounded-5">
                <p class="mb-1"><strong class="pera-green"><%= t("flashcards.question_prefix") %></strong> <%= with_furigana(flashcard.question, show: show_furigana?) %></p>
                <p class="mb-0"><strong class="pera-green"><%= t("flashcards.answer_prefix") %></strong> <%= with_furigana(flashcard.answer, show: show_furigana?) %></p>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-muted">
      <%= params[:query].present? ? t("flashcards.no_match", query: params[:query]) : t(".empty") %>
    </p>
  <% end %>
</div>
