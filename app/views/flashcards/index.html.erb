<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">All Flashcards</h1>
    <%= form_with url: flashcards_path, method: :get, class: "d-flex" do |f| %>
      <%= f.text_field :query, value: params[:query], placeholder: "Search flashcards...", class: "form-control me-2" %>
      <%= f.submit "Search", class: "btn btn-outline-primary" %>
    <% end %>
  </div>
  <% if @flashcards.any? %>
    <div class="row">
      <% @flashcards.each do |flashcard| %>
        <div class="col-md-4 mb-3">
          <%= link_to edit_flashcard_path(flashcard), data: { turbo_frame: "modal" }, class: "text-decoration-none text-dark" do %>
            <div class="card p-3">
              <p class="mb-1"><strong>Q:</strong> <%= flashcard.question %></p>
              <p class="mb-0 text-muted"><strong>A:</strong> <%= flashcard.answer %></p>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-muted">
      <%= params[:query].present? ? "No flashcards match \"#{params[:query]}\"." : "No flashcards yet." %>
    </p>
  <% end %>
</div>
