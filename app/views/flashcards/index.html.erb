<div class="container mt-5">
  <div class="d-flex justify-content-between align-items-center my-5">
    <h1 class="mb-0">All Flashcards</h1>
    <%= form_with url: flashcards_path, method: :get, class: "d-flex" do |f| %>
      <%= f.text_field :query, value: params[:query], placeholder: "Search flashcards...",
      class: "form-control me-2 rounded-4 user-details-input" %>
      <%= f.submit "Search", class: "btn pera-btn rounded-4" %>
    <% end %>
  </div>
  <% if @flashcards.any? %>
    <div class="row mb-5">
      <% @flashcards.each do |flashcard| %>
        <div class="col-md-4 mb-3">
          <div class="position-relative">
            <%= button_to flashcard_path(flashcard),
                  method: :delete,
                  class: "btn btn-sm border-0 position-absolute top-0 end-0 m-2",
                  style: "z-index: 1;",
                  form: { data: { turbo_confirm: "Delete this flashcard?" } } do %>
              <i class="fa-solid fa-trash pera-green"></i>
            <% end %>
            <%= link_to edit_flashcard_path(flashcard), data: { turbo_frame: "modal-#{flashcard.id}" },
            class: "text-decoration-none text-dark rounded-5" do %>
              <div class="card p-3 flashcard-preview-card dash-card js-dash-card dash-card-dark rounded-5">
                <p class="mb-1"><strong class="pera-green">Q:</strong> <%= flashcard.question %></p>
                <p class="mb-0"><strong class="pera-green">A:</strong> <%= flashcard.answer %></p>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-muted">
      <%= params[:query].present? ? "No flashcards match \"#{params[:query]}\"." : "No flashcards yet." %>
    </p>
  <% end %>
</div>
