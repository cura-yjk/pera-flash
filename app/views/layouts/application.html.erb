<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "ペラFlash" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Pera Flash">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%# Installable to a phone's home screen -- see config/routes.rb and
        app/views/pwa/. The theme colour paints the browser and task-switcher
        chrome around the app so it does not sit in a white frame. %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <meta name="theme-color" content="#2BAE8F">
    <link rel="apple-touch-icon" href="/icon-192.png">
    <%= favicon_link_tag 'favicon.png' %>
    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%# Animations run for up to 3.5 seconds here, and a browser driver clicks
        at coordinates it measured a moment earlier -- so a click can land
        where a moving element used to be and silently do nothing. Switching
        them off in test only makes system tests deterministic; nothing about
        the real app changes. %>
    <% if Rails.env.test? %>
      <style>
        *, *::before, *::after {
          animation-duration: 0s !important;
          animation-delay: 0s !important;
          transition-duration: 0s !important;
          transition-delay: 0s !important;
        }

        /* Bootstrap sets scroll-behavior: smooth on html. A browser driver
           scrolls an element into view and then clicks its coordinates, so
           while that scroll is still animating the click lands where the
           element used to be -- silently, with no error and no overlay to
           find. That is the phantom click that made these tests flaky. */
        html { scroll-behavior: auto !important; }
      </style>
    <% end %>
  </head>
  <body>
    <% unless user_signed_in? %>
      <%= render "shared/landing_navbar" %>
    <% end %>

    <% if user_signed_in? %>
      <%= render "shared/navbar" %>
    <% end %>

    <div class="main">
      <%= yield %>
      <%= render "shared/flashes" %>
    </div>

    <%= render "shared/footer" %>
    <%= turbo_frame_tag "modal" %>
  </body>
</html>
