<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "ペラFlash" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Pera Flash">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%# Installable to a phone's home screen -- see config/routes.rb and
        app/views/pwa/. The theme colour paints the browser and task-switcher
        chrome around the app so it does not sit in a white frame. %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <meta name="theme-color" content="#2BAE8F">
    <link rel="apple-touch-icon" href="/icon-192.png">
    <%= favicon_link_tag 'favicon.png' %>
    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <% unless user_signed_in? %>
      <%= render "shared/landing_navbar" %>
    <% end %>

    <% if user_signed_in? %>
      <%= render "shared/navbar" %>
    <% end %>

    <div class="main">
      <%= yield %>
      <%= render "shared/flashes" %>
    </div>

    <%= render "shared/footer" %>
    <%= turbo_frame_tag "modal" %>
  </body>
</html>
