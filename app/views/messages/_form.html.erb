<%= simple_form_for [conversation, message], html: { data: { controller: 'load' } } do |f| %>
  <%= f.input :content, input_html: { id: "chat-input", class: "rounded-4", placeholder: "Ask something..." }, required: true, label: false %>
  <%= f.button :submit, 'Send', class: 'btn pera-btn rounded-3', data: { action: 'click->load#start'} %>
<% end %>
