<%#= simple_form_for [conversation, message], html: { data: { controller: 'load' } } do |f| %>
  <%#= f.input :content, placeholder: "Ask something...", required: true, label: false %>
  <%#= f.button :submit, 'Send', class: 'btn btn-primary', data: { action: 'click->load#start'} %>
<%# end %>

<div class="chat-input-container">

  <%= simple_form_for [conversation, message],
    html: {
      data: {
        controller: 'reset-form',
        action: 'turbo:submit-start->reset-form#submit'
      },
      class: 'd-flex justify-content-between px-3 pb-2'
    } do |f| %>

    <div class="chat-input">
    <%= f.input :content,
          placeholder: "Ask something...",
          required: true,
          label: false,
          input_html: { data: { reset_form_target: "input" }, id: "chat-input", class: "rounded-4 me-3" },
          wrapper_html: { class: 'rounded-5 flex-grow-1', style: 'margin-bottom: 0 !important' } %>
    </div>

    <div>
        <%= f.button :submit, 'Send',
              class: 'submit-btn rounded-5',
              data: { reset_form_target: "submit" } %>
      <% end %>
    </div>

  </div>
