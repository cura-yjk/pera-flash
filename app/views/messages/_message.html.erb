<% if message.role == "user" %>
  <div class="d-flex justify-content-end mb-2" data-controller="scroll">
    <div class="bg-white px-3 pb-0 pt-3 rounded-5 user-message">
      <%= raw(render_markdown(message.content)) %>
    </div>
  </div>
<% elsif message.role == "assistant" && message.content.start_with?("✅") %>
  <div class="d-flex align-items-center gap-3 my-4 system-notification">
    <hr class="flex-grow-1 m-0">
    <div class="notification-pill dash-card js-dash-card rounded-5">
      <i class="fa-solid fa-circle-check pera-green"></i>
      <%= raw(render_markdown(message.content.delete_prefix("✅ "))) %>
    </div>
    <hr class="flex-grow-1 m-0">
  </div>
<% elsif message.role == "assistant" %>
  <%= image_tag "pera.png", alt: "Pera", id: "pera-chat" %>
  <div class="d-flex justify-content-start mb-5">
    <div class="px-3 pb-0 pt-3 assistant-message my-4">
      <%= raw(render_markdown(message.content)) %>
    </div>
  </div>
<% end %>
