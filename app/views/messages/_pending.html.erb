<%# Where the reply streams in. Starts as the loading state and is replaced by
    the finished message -- rendered server-side, because markdown and furigana
    cannot be rendered from a half-written string. %>
<div data-controller="reply-stream"
     data-reply-stream-url-value="<%= conversation_reply_path(conversation) %>"
     data-reply-stream-failed-value="<%= render("messages/reply_failed") %>">
  <%= image_tag "pera.png", alt: "Pera", id: "pera-chat" %>
  <div class="d-flex justify-content-start mb-5">
    <div class="px-3 pb-0 pt-3 assistant-message my-4">
      <div class="streaming-text" data-reply-stream-target="text"></div>
      <p class="mb-0 pera-green" data-reply-stream-target="cursor">
        <i class="fa-solid fa-pen-nib"></i> <%= t(".writing") %><span class="writing-dots" aria-hidden="true"><span>.</span><span>.</span><span>.</span></span>
      </p>
    </div>
  </div>

  <%# The page holds still while the reply grows, so a long one runs on below
      the window with nothing to say it is still coming. Shown only while the
      newest text is out of sight, and gone with the rest of this partial when
      the finished message is swapped in. %>
  <button type="button" class="more-below" hidden
          data-reply-stream-target="more" data-action="reply-stream#scrollToLatest">
    <i class="fa-solid fa-arrow-down" aria-hidden="true"></i> <%= t(".more_below") %>
  </button>
</div>
