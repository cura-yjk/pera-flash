<%= turbo_stream.replace "conversation_title" do %>
  <%= render "conversations/title", conversation: @conversation %>
<% end %>
<%= turbo_stream.append "messages" do %>
  <%= render "messages/message", message: @message %>
  <%= render "messages/message", message: @assistant_message %>
<% end %>
<%= turbo_stream.update "new_message" do %>
  <%= render "messages/form", conversation: @conversation, message: Message.new %>
<% end %>
<%= turbo_stream.update "flashcard-btn" do %>
  <%= render "flashcards/btn", conversation: @conversation, messages: @conversation.messages %>
<% end %>
