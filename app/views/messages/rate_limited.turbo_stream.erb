<%# Shown in place of a reply when the account is over its rate limit. Not
    persisted as a message: it would end up in the transcript replayed to the
    model next turn. %>
<%= turbo_stream.append "messages" do %>
  <div class="d-flex align-items-center gap-3 my-4 system-notification" data-controller="scroll">
    <hr class="flex-grow-1 m-0">
    <div class="notification-pill dash-card js-dash-card rounded-5">
      <i class="fa-solid fa-hourglass-half text-warning"></i>
      <%= notice %>
    </div>
    <hr class="flex-grow-1 m-0">
  </div>
<% end %>
