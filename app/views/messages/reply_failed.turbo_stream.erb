<%# The user's message is saved and shown -- losing what they typed would be
    worse than the missing reply. The notice is not persisted as a message:
    it would end up in the transcript replayed to the model next turn. %>
<%= turbo_stream.append "messages" do %>
  <%= render "messages/message", message: @message %>

  <div class="d-flex align-items-center gap-3 my-4 system-notification" data-controller="scroll">
    <hr class="flex-grow-1 m-0">
    <div class="notification-pill dash-card js-dash-card rounded-5">
      <i class="fa-solid fa-triangle-exclamation text-warning"></i>
      <%= t("messages.reply_failed") %>
    </div>
    <hr class="flex-grow-1 m-0">
  </div>
<% end %>

<%= turbo_stream.update "new_message" do %>
  <%= render "messages/form", conversation: @conversation, message: Message.new %>
<% end %>
