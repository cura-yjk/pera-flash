<%# when user is NOT signed in %>
<div class="container d-flex flex-column align-items-center justify-content-around my-5 gap-5" id="landing-container">
  <% unless user_signed_in? %>
    <h1 class="text-center landing-title play-1"><%= t(".welcome") %></h1>
    <div class="col-5 welcome-container landing-text play-2">
      <div class="landing-left">
        <h2 class="fw-bold"><%= t(".tagline") %></h2>
        <ul>
          <% t(".features").each do |feature| %>
            <li><%= feature %></li>
          <% end %>
        </ul>
        <div class="button-container play-3">
          <%= link_to t(".get_started"), new_user_registration_path, class: "btn pera-btn rounded-3" %>
          <%= link_to t("sessions.log_in"), new_user_session_path, class: "btn pera-btn-outline rounded-3" %>
        </div>
      </div>
      <div class="landing-right play-4">
        <%= image_tag "landingclear.png", alt: t(".illustration_alt"), id: "pera-landing" %>
      </div>
    </div>
  <% end %>
  <%# when user is signed in %>
  <% if user_signed_in? %>
    <div class="menu-nav form-container">
      <h1 class="text-center"><%= t(".ready") %></h1>
      <div class="menu-container my-5">
        <div class="left-side rounded-5 gap-3">
          <h2><%= t(".dashboard") %></h2>
          <i class="fa-regular fa-rectangle-list menu-icon"></i>
          <p><%= t(".dashboard_blurb") %></p>
          <%= link_to t(".go"), dashboard_path, class: "btn pera-btn rounded-3" %>
        </div>
        <div class="right-side rounded-5 gap-3">
          <h2><%= t("conversations.new_chat") %></h2>
          <i class="fa-regular fa-message menu-icon"></i>
          <p><%= t(".chat_blurb") %></p>
          <%= link_to t("conversations.new_chat"), conversations_path, data: { turbo_method: :post }, class: "btn pera-btn rounded-3" %>
        </div>
      </div>
    </div>
  <% end %>
</div>
