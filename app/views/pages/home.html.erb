<%# when user is NOT signed in %>
<div class="container d-flex align-items-center justify-content-around my-5 gap-5" id="landing-container">

    <% unless user_signed_in? %>
    <div class="col-5" id="landing-text">
      <div id="landing-title">
        <h1 class="text-center my-5">Welcome to ペラFlash!</h1>
      </div>
      <h2 class="fw-bold">Master Japanese with Pera!</h2>
      <p>
        Lorem ipsum dolor sit amet consectetur adipisicing elit. Dolore, rem soluta? Quia eius expedita rem mollitia magnam voluptatibus repellat reiciendis magni temporibus eum iure, perferendis enim necessitatibus suscipit laboriosam, cumque consectetur reprehenderit earum ut ducimus. Optio eveniet possimus eos blanditiis voluptatem repellat, tenetur enim voluptates, quod exercitationem dolore dolor? Eaque voluptatem velit, ut natus voluptatibus fugit nisi doloremque voluptates.
      </p>
      <div class="button-container">
          <%= link_to "Get started", new_user_registration_path, class: "btn pera-btn rounded-3" %>
          <%= link_to "Log in", new_user_session_path, class: "btn pera-btn-outline rounded-3" %>
        <% end %>
      </div>
    </div>

  <%# when user is signed in %>

    <% if user_signed_in? %>
    <div class="menu-nav d-flex gap-5 align-items-center">
      <div class="col-3" id="landing-btn">
        <h1 class="mb-5">Some sample text for now</h1>
        <div class="left-side col-6 rounded-5 gap-3">
          <h2>Dashboard</h2>
          <p>Review cards and more!</p>
          <i class="fa-regular fa-rectangle-list icon-link" style="color: rgb(0, 0, 0);"></i>
          <%= link_to "Go", conversations_path, data: { turbo_method: :post }, class: "btn pera-btn rounded-3" %>
        </div>

        <div class="right-side col-6 rounded-5 gap-3">
          <h2>New Chat</h2>
          <p>Chat with Pera and learn!</p>
          <i class="fa-regular fa-message icon-link mt-1" style="color: rgb(0, 0, 0);"></i>
          <%= link_to "New Chat", conversations_path, data: { turbo_method: :post }, class: "btn pera-btn rounded-3" %>
      </div>
    </div>
    <% end %>
  </div>
</div>
