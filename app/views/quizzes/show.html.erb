<div class="container my-5">
  <div class="d-flex flex-wrap align-items-center gap-2 mb-4">
    <i class="fa-solid fa-list-check fs-4 pera-green me-2"></i>
    <h2 class="mb-0 pera-green"><%= @deck ? t(".title_for_deck", deck: @deck.name) : t(".title") %></h2>
  </div>

  <p class="text-uppercase small fw-semibold pera-green mb-4">
    <%= t(".progress", position: @position, total: @total) %>
  </p>

  <div class="flashcard-preview-card shadow-sm rounded-5 overflow-hidden mx-auto" style="max-width: 34rem;">
    <div class="p-4 text-center">
      <%# The prompt is the thing being tested, so a mastered card asks it in
          bare kanji. The options below keep their readings: they are answers,
          and one of them is about to be revealed as correct anyway. %>
      <p class="fs-4 mb-0"><%= with_furigana(@question.card.question, show: show_furigana_for?(@question.card)) %></p>
    </div>
  </div>

  <%# One form per option rather than radios plus a submit: a tap is the whole
      interaction, and the answer text is what the controller grades on. %>
  <div class="d-grid gap-2 mx-auto mt-4" style="max-width: 34rem;">
    <% @question.options.each do |option| %>
      <%= button_to quiz_path_for(@deck), method: :post, params: { choice: option },
            class: "btn btn-outline-secondary text-start py-3 px-4 w-100" do %>
        <%= with_furigana(option, show: show_furigana?) %>
      <% end %>
    <% end %>
  </div>
</div>
