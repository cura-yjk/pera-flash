<%# A multiple-choice question needs something to choose between. Rather than
    show one option, send the learner to the review flow, which works with a
    single card. %>
<div class="container my-5 text-center">
  <i class="fa-solid fa-layer-group fs-1 pera-green mb-3 d-block"></i>
  <h3 class="pera-green"><%= t(".title") %></h3>
  <p class="mb-4">
    <%= t(".explanation") %>
  </p>
  <%= link_to t(".review_instead"), @deck ? deck_review_path(@deck) : review_path,
        class: "btn pera-btn-outline px-4" %>
</div>
