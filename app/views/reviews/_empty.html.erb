<%# Nothing due. Deliberately not framed as a failure -- an empty queue is the
    system working. %>
<div id="review-card" class="text-center my-5">
  <i class="fa-solid fa-circle-check fs-1 pera-green mb-3 d-block"></i>
  <h3 class="pera-green"><%= t(".title") %></h3>
  <p class="mb-4">
    <% if studied_any %>
      <%= t(".up_to_date") %>
    <% else %>
      <%= t(".nothing_studied") %>
    <% end %>
  </p>
  <%= link_to study_back_label(deck), study_back_path(deck), class: "btn gen-flash-btn rounded-4 px-4" %>
</div>
