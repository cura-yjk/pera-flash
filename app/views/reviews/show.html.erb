<div class="container my-5">
  <div class="d-flex flex-wrap align-items-center gap-2 mb-4">
    <i class="fa-solid fa-layer-group fs-4 pera-green me-2"></i>
    <h2 class="mb-0 pera-green"><%= @deck ? t(".title_for_deck", deck: @deck.name) : t(".title") %></h2>

    <%# Hiding readings is how you check whether the kanji has actually stuck. %>
    <%# turbo_submits_with disables the button and says what is happening while
        the request is in flight. Without it a slow round trip looks like a
        click that did nothing, and the second click puts the setting back. %>
    <%= button_to toggle_furigana_path, method: :patch,
          class: "btn btn-sm btn-outline-secondary rounded-4 ms-auto",
          data: { turbo_submits_with: t("furigana.updating") } do %>
      <i class="fa-solid fa-language me-1"></i>
      <%= show_furigana? ? t("furigana.hide") : t("furigana.show") %>
    <% end %>
  </div>

  <% if @card %>
    <%= render "card", card: @card, remaining: @remaining, deck: @deck %>
  <% else %>
    <%= render "empty", studied_any: Flashcard.for_user(current_user).exists? %>
  <% end %>
</div>
