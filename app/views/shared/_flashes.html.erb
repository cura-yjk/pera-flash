<% if notice %>
  <div
  class="alert alert-light alert-dismissible fade show m-1 pera-flash rounded-5 dash-card js-dash-card"
  role="alert">
    <%= notice %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close">
    </button>
  </div>
<% end %>
<% if alert %>
  <div class="alert-light alert-dismissible fade show m-1 pera-flash rounded-5 dash-card js-dash-card" role="alert">
    <%= alert %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close">
    </button>
  </div>
<% end %>
