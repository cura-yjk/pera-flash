<nav class="navbar navbar-expand-lg bg-body-tertiary nav-bar mb-5 fixed-top">
  <div class="container-fluid">
    <div class="d-flex align-items-center gap-5">
      <%= link_to root_path, class: "logo-link" do %>
        <%= image_tag "logo.png", alt: "Pera Flash logo", id: "pera-logo" %>
      <% end %>
      <i class="fa-solid fa-circle-half-stroke js-toggle-btn toggle-btn"
        style="color: rgb(0, 0, 0);"
        title="<%= t("nav.theme") %>"
        aria-label="<%= t("nav.theme") %>"
        role="button"
        data-dark-mode-target="darkToggle"
        data-controller="dark-mode"
        data-action="click->dark-mode#toggle">
        </i>
      <%= link_to dashboard_path, title: t("nav.dashboard"), aria: { label: t("nav.dashboard") } do %>
        <i class="fa-regular fa-rectangle-list icon-link" style="color: rgb(0, 0, 0);" aria-hidden="true"></i>
      <% end %>
      <%= link_to conversations_path, data: { turbo_method: :post },
                  title: t("conversations.new_chat"), aria: { label: t("conversations.new_chat") } do %>
        <i class="fa-regular fa-message icon-link mt-1" style="color: rgb(0, 0, 0);" aria-hidden="true"></i>
      <% end %>

      <%# Both hidden when there is nothing to do: an empty queue means the
          schedule is working, not that the user has a task outstanding. %>
      <% if due_card_count.positive? %>
        <%= link_to review_path, class: "position-relative", title: t("reviews.show.title"),
                    aria: { label: t("reviews.show.title") } do %>
          <i class="fa-solid fa-layer-group icon-link" style="color: rgb(0, 0, 0);" aria-hidden="true"></i>
          <span class="position-absolute top-0 start-100 translate-middle badge rounded-5 nav-due-badge">
            <%= due_card_count %>
          </span>
        <% end %>
      <% end %>

      <% if quiz_available? %>
        <%= link_to quiz_path, title: t("quizzes.show.title"), aria: { label: t("quizzes.show.title") } do %>
          <i class="fa-regular fa-circle-question icon-link" style="color: rgb(0, 0, 0);" aria-hidden="true"></i>
        <% end %>
      <% end %>
    </div>

    <div>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse d-lg-flex align-items-lg-center gap-lg-3" id="navbarSupportedContent">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"
               title="<%= t("nav.account") %>" aria-label="<%= t("nav.account") %>">
              <i class="fa-solid fa-circle-user" style="color: rgb(0, 0, 0);" aria-hidden="true"></i>
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
              <li><%= link_to t("decks.index.title"), decks_path, class: "text-dark text-decoration-none me-3 pera-text dropdown-item" %></li>
              <li><%= link_to t("conversations.index.title"), conversations_path, class: "text-dark text-decoration-none me-3 pera-text dropdown-item" %></li>
              <li><%= link_to t("flashcards.index.title"), flashcards_path, class: "text-dark text-decoration-none me-3 pera-text dropdown-item" %></li>
              <li><hr class="dropdown-divider"></li>
              <li>
                <%= button_to toggle_furigana_path, method: :patch,
                              class: "dropdown-item text-dark pera-text border-0 bg-transparent",
                              data: { turbo_submits_with: t("furigana.updating") } do %>
                  <i class="fa-solid fa-language me-1"></i>
                  <%= show_furigana? ? t("furigana.hide") : t("furigana.show") %>
                <% end %>
              </li>
              <li><hr class="dropdown-divider"></li>
              <li><%= link_to t("sessions.log_out"), destroy_user_session_path, data: {turbo_method: :delete}, class: "dropdown-item text-pera" %></li>
            </ul>
          </li>
        </ul>
    </div>

  </div>
</nav>
