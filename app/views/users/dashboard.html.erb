<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Welcome back, <%= current_user.name %></h1>
    <%= link_to "New Chat", conversations_path, data: { turbo_method: :post }, class: "btn btn-primary" %>
  </div>
  <!-- Stats -->
  <div class="d-flex gap-3 mb-4">
    <div class="card p-3 text-center flex-fill">
      <h3><%= @deck_count %></h3>
      <p class="mb-0">Decks</p>
    </div>
    <div class="card p-3 text-center flex-fill">
      <h3><%= @flashcard_count %></h3>
      <p class="mb-0">Flashcards</p>
    </div>
  </div>
  <!-- Random flashcard -->
  <div class="card p-3 mb-4">
    <h5>Flashcard of the moment</h5>
    <% if @random_flashcard %>
      <p><strong>Q:</strong> <%= @random_flashcard.question %></p>
      <p><strong>A:</strong> <%= @random_flashcard.answer %></p>
    <% else %>
      <p class="text-muted">No flashcards yet — start a chat to generate some!</p>
    <% end %>
  </div>
  <!-- Conversation history -->
  <h2>Your Conversations</h2>
  <% if @conversations.any? %>
    <ul class="list-group mb-4">
      <% @conversations.each do |conversation| %>
        <li class="list-group-item">
          <%= link_to (conversation.title.presence || "Untitled conversation"), conversation_path(conversation) %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-muted mb-4">No conversations yet.</p>
  <% end %>
  <!-- Decks -->
  <h2>Your Decks</h2>
  <% if @decks.any? %>
    <ul class="list-group">
      <% @decks.each do |deck| %>
        <li class="list-group-item"><%= deck.name %></li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-muted">No decks yet.</p>
  <% end %>
</div>
