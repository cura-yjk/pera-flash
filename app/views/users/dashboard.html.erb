<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-5">
    <h1 class="mb-0">Welcome back, <%= current_user.name %>!</h1>
    <%= link_to "New Chat", conversations_path, data: { turbo_method: :post }, class: "btn pera-btn rounded-3" %>
  </div>

  <!-- Decks -->
  <h2>Recent Decks</h2>
  <% if @decks.any? %>
    <div class="row mb-5">
      <% @decks.last(3).each do |deck| %>
        <div class="col-md-4 mb-3">
          <%= link_to deck_path(deck), class: "text-decoration-none text-dark" do %>
            <div class="card p-3 rounded-5 dash-card js-dash-card d-flex flex-row justify-content-between align-items-center">
              <span><%= deck.name %></span>
              <span class="badge rounded-pill pera-btn"><%= deck.flashcards_count %></span>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-secondary mb-5">No decks yet.</p>
  <% end %>

  <!-- Stats -->
  <div class="d-flex gap-5 mb-5">

  <!-- Random flashcard -->
    <div class="card p-3 mb-5 rounded-5 dash-card js-dash-card col-8">
      <h5>Flashcard of the moment</h5>
      <% if @random_flashcard %>
        <p><strong>Q:</strong> <%= @random_flashcard.question %></p>
        <p><strong>A:</strong> <%= @random_flashcard.answer %></p>
      <% else %>
        <p class="pera-text">No flashcards yet — start a chat to generate some!</p>
      <% end %>
    </div>

    <div class="card p-3 text-center flex-fill rounded-5 dash-card js-dash-card col-4">
      <h3><%= @flashcard_count %></h3>
      <p class="mb-0">Flashcards</p>
    </div>
  </div>

  <!-- Recent flashcards -->
  <h2>Recent Flashcards</h2>
  <% if @recent_flashcards.any? %>
    <div class="row mb-5">
      <% @recent_flashcards.each do |flashcard| %>
        <div class="col-md-4 mb-3">
          <div class="position-relative">
            <%= button_to flashcard_path(flashcard),
                  method: :delete,
                  class: "btn btn-sm btn-light border-0 position-absolute top-0 end-0 m-2",
                  style: "z-index: 1;",
                  form: { data: { turbo_confirm: "Delete this flashcard?" } } do %>
              <i class="fa-solid fa-trash text-danger"></i>
            <% end %>
            <%= link_to edit_flashcard_path(flashcard), data: { turbo_frame: "modal-#{flashcard.id}" }, class: "text-decoration-none text-dark" do %>
              <div class="card p-3 rounded-5 dash-card js-dash-card">
                <p class="mb-1"><strong>Q:</strong> <%= flashcard.question %></p>
                <p class="mb-0 text-muted"><strong>A:</strong> <%= flashcard.answer %></p>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
    <%= link_to "See all flashcards", flashcards_path, class: "pera-text" %>
  <% else %>
    <p class="text-muted mb-5">No flashcards yet.</p>
  <% end %>

  <!-- Conversation history -->
  <h2>Your Recent Conversations</h2>
  <% if @conversations.any? %>
    <ul class="list-group mb-5 rounded-5 dash-card js-dash-card">
      <% @conversations.last(7).each do |conversation| %>
        <li class="list-group-item js-dash-card conv-link">
          <%= link_to (conversation.title.presence || "Untitled conversation"),
          conversation_path(conversation),
          class: "text-decoration-none text-secondary" %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-muted mb-4 js-dash-card">No conversations yet.</p>
  <% end %>
</div>
