<div class="container mt-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-5">
    <h1 class="mb-0"><%= t(".welcome", name: current_user.name) %></h1>
    <div class="d-flex flex-wrap gap-2">
      <%# Only shown when there is something to study -- an empty queue means
          the system is working, not that the user has a task outstanding. %>
      <% if due_card_count.positive? %>
        <%= link_to review_path, class: "btn pera-btn rounded-3 d-flex align-items-center gap-2" do %>
          <i class="fa-solid fa-layer-group"></i>
          <%= t(".review") %> <span class="badge rounded-5 bg-light text-dark"><%= due_card_count %></span>
        <% end %>
      <% end %>
      <% if quiz_available? %>
        <%= link_to t(".quiz"), quiz_path, class: "btn pera-btn rounded-3 d-flex align-items-center gap-2" %>
      <% end %>
      <%= link_to t(".new_chat"), conversations_path, data: { turbo_method: :post }, class: "btn pera-btn rounded-3" %>
    </div>
  </div>

  <!-- Decks -->
  <h2 class="my-5"><%= t(".recent_decks") %></h2>
  <% if @decks.any? %>
    <div class="row mb-5">
      <% @decks.last(3).each do |deck| %>
        <div class="col-md-4 mb-3">
          <%= link_to deck_path(deck), class: "text-decoration-none text-dark" do %>
            <div class="card p-3 rounded-5 dash-card js-dash-card deck-card-dash">
              <span><%= deck.name %></span>
              <span class="badge rounded-5 pera-btn d-flex align-items-center justify-content-center fs-6"><%= deck.flashcards_count %></span>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-secondary mb-5"><%= t(".no_decks") %></p>
  <% end %>

  <!-- Stats -->
  <div class="d-flex gap-5 mb-5">

  <!-- Random flashcard -->
    <div class="card p-3 mb-5 rounded-5 dash-card js-dash-card col-8">
      <h4 class="pera-green mb-4"><%= t(".random_card") %></h4>
      <% if @random_flashcard %>
        <p><strong class="pera-green"><%= t("flashcards.question_prefix") %></strong> <%= @random_flashcard.question %></p>
        <p><strong class="pera-green"><%= t("flashcards.answer_prefix") %></strong> <%= @random_flashcard.answer %></p>
      <% else %>
        <p class="pera-text"><%= t(".no_cards_yet") %></p>
      <% end %>
    </div>

    <div class="card p-3 text-center flex-fill rounded-5 dash-card js-dash-card col-4">
      <h3 class="pera-green"><%= @flashcard_count %></h3>
      <p class="mb-0"><%= t(".flashcards") %></p>
    </div>
  </div>

  <!-- Recent flashcards -->
  <h2 class="mb-5"><%= t(".recent_flashcards") %></h2>
  <% if @recent_flashcards.any? %>
    <div class="row mb-5">
      <% @recent_flashcards.each do |flashcard| %>
        <div class="col-md-4 mb-3">
          <div class="position-relative">
            <%= button_to flashcard_path(flashcard),
                  method: :delete,
                  class: "btn btn-sm border-0 position-absolute top-0 end-0 m-2",
                  style: "z-index: 1;",
                  form: { data: { turbo_confirm: t("flashcards.confirm_delete") } } do %>
              <i class="fa-solid fa-trash pera-green"></i>
            <% end %>
            <%= link_to edit_flashcard_path(flashcard), data: { turbo_frame: "modal-#{flashcard.id}" }, class: "text-decoration-none text-dark" do %>
              <div class="card p-3 rounded-5 dash-card js-dash-card">
                <p class="mb-1"><strong class="pera-green"><%= t("flashcards.question_prefix") %></strong> <%= with_furigana(flashcard.question, show: show_furigana?) %></p>
                <p class="mb-0"><strong class="pera-green"><%= t("flashcards.answer_prefix") %></strong> <%= with_furigana(flashcard.answer, show: show_furigana?) %></p>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-muted mb-5"><%= t(".no_flashcards") %></p>
  <% end %>

  <!-- Conversation history -->
  <div class="d-flex justify-content-between align-items-baseline mb-3">
    <h2 class="mb-0"><%= t(".recent_conversations") %></h2>
    <%= link_to t(".view_all"), conversations_path, class: "text-decoration-none pera-text small" %>
  </div>
  <% if @conversations.any? %>
    <ul class="list-group mb-5 rounded-5 dash-card js-dash-card">
      <%= render @conversations %>
    </ul>
  <% else %>
    <p class="text-muted mb-4 js-dash-card"><%= t(".no_conversations") %></p>
  <% end %>
</div>
